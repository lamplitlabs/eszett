{
  "expo": {
    "name": "Eszett",
    "slug": "eszett-german-tutor",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eszett",
    "userInterfaceStyle": "automatic",
    "description": "Eszett, a German tutor for A1 to B2 that runs the lamplitlabs/licht-german-tutor model on the phone.",
    "ios": {
      "bundleIdentifier": "com.lamplitlabs.eszett",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Eszett can fetch the tutor model from a computer on your local network during development.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true,
        "com.apple.developer.kernel.extended-virtual-addressing": true
      }
    },
    "android": {
      "package": "com.lamplitlabs.eszett",
      "adaptiveIcon": {
        "backgroundColor": "#2442C6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.lamplitlabs.eszett",
      "versionCode": 2
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#F5F6F9"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0E1322",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      "expo-localization",
      "expo-iap",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Eszett uses the microphone so you can say your German lines and have them checked.",
          "speechRecognitionPermission": "Eszett uses the phone’s own speech recognition to write down the German you say; nothing is sent to a server."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2442C6",
          "defaultChannel": "reminders"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/withUploadSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
